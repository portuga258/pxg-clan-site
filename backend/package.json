{
  "name": "pxg-clan-backend",
  "version": "1.0.0",
  "description": "Backend API for PXG Clan Site",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/utils/initDb.js && node src/index.js",
    "dev": "node src/utils/initDb.js && node --watch src/index.js",
    "db:init": "node src/utils/initDb.js",
    "db:seed": "node src/utils/seedDb.js",
    "catalog:sync": "node src/utils/syncItemCatalog.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "better-sqlite3": "^12.4.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1",
    "discord-oauth2": "^2.11.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0",
    "npm": ">=9.0.0"
  }
}