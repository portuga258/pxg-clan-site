# Server
PORT=3001
NODE_ENV=development

# Public frontend origin; multiple origins can be comma-separated.
FRONTEND_URL=https://motivated-consideration-production-cc8dc721.up.railway.app

# JWT
JWT_SECRET=pxg-clan-super-secret-key-change-in-production-min-32-chars

# Optional Discord OAuth2
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# Database
DATABASE_PATH=./data/pxg-clan.db

# Optional Discord Webhook (for notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token